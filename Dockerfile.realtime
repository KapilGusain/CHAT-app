FROM node:22-bookworm-slim AS runtime

WORKDIR /app

# Prisma | when prisma generate is run in the image build, generated client tooling requires a real-looking DATABASE_URL
ARG DATABASE_URL="postgresql://build:build@localhost:5432/build"
ENV DATABASE_URL=${DATABASE_URL}

COPY package.json package-lock.json ./
COPY realtime/package.json realtime/package-lock.json ./realtime/
COPY packages/db/package.json ./packages/db/

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/* \
    && npm ci --include=dev

ENV NODE_ENV=production

COPY prisma ./prisma
COPY prisma.config.ts ./
COPY packages/db ./packages/db
COPY realtime ./realtime

RUN npx prisma generate

EXPOSE 4000

# The current @chat/db workspace exposes TypeScript source rather than
# a compiled package entrypoint, so run the realtime service with tsx.
CMD ["./realtime/node_modules/.bin/tsx", "realtime/src/server.ts"]
